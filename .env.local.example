# Copy this file to .env.local and fill in your own Supabase project values
# (Project Settings > API in your Supabase dashboard)

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # REQUIRED: bookings, payments and tariff changes are written server-side with it

# --- Migration runner (optional, see scripts/run-sql.cjs) ---
SUPABASE_ACCESS_TOKEN=sbp_your-personal-access-token

# --- Email (optional — tests pass without it; sendEmail becomes a no-op) ---
# Get an API key at https://resend.com/api-keys
RESEND_API_KEY=re_...
EMAIL_FROM=Highland <noreply@highland.am>

# Where the footer's suggestion form forwards messages (optional)
CONTACT_INBOX=you@example.com

# Testing before a domain exists: auth emails from a Gmail account
# (node scripts/configure-auth.cjs --gmail). Use an App password, not your
# normal Gmail password.
# The app also sends its own emails through this account while RESEND_API_KEY
# is not set.
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# --- Site URL (used in email links; defaults to localhost:3000) ---
NEXT_PUBLIC_SITE_URL=https://highland.am

# --- Daily job (package reminders + newsletter digest) ---
# Vercel Cron calls /api/cron/daily with "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=a-long-random-string
