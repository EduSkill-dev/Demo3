# Copy this file to .env.local and fill in your own Supabase project values
# (Project Settings > API in your Supabase dashboard)

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # REQUIRED: bookings, payments and tariff changes are written server-side with it

# --- Migration runner (optional, see scripts/run-sql.cjs) ---
SUPABASE_ACCESS_TOKEN=sbp_your-personal-access-token

# --- Email (optional — tests pass without it; sendEmail becomes a no-op) ---
# Get an API key at https://resend.com/api-keys
RESEND_API_KEY=re_...
EMAIL_FROM=Highland <noreply@highland.am>

# --- Site URL (used in email links; defaults to localhost:3000) ---
NEXT_PUBLIC_SITE_URL=https://highland.am
